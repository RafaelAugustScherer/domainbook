{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enforcement": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "block",
          "type": "string",
          "enum": [
            "block",
            "warn"
          ]
        },
        "trailer": {
          "default": "Skip-Docs",
          "type": "string",
          "minLength": 1
        },
        "require_reason": {
          "default": "agents",
          "type": "string",
          "enum": [
            "agents",
            "always"
          ]
        }
      },
      "additionalProperties": false
    },
    "collaboration": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether this book shares claims and drafts through the git remote. Off, the repo works alone as before.",
          "type": "boolean"
        },
        "remote": {
          "default": "origin",
          "description": "The git remote peers share.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "site": {
      "default": {},
      "type": "object",
      "properties": {
        "base": {
          "default": "/",
          "description": "The path the built site is published under, starting with a slash.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\/"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "domainbook config"
}
