{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*)*$",
      "description": "Words joined by single hyphens, each starting with a letter or digit in any script, with no capitals. The pattern uses Unicode property escapes and must be compiled with the ECMA-262 \"u\" flag."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "implemented",
        "deprecated"
      ]
    },
    "owners": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*)*$",
        "description": "Words joined by single hyphens, each starting with a letter or digit in any script, with no capitals. The pattern uses Unicode property escapes and must be compiled with the ECMA-262 \"u\" flag."
      }
    },
    "decisions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*)*\\/)?ADR-\\d{4}$",
        "description": "\"ADR-NNNN\", or \"<domain-id>/ADR-NNNN\" for a domain's own log. The pattern uses Unicode property escapes and must be compiled with the ECMA-262 \"u\" flag."
      }
    }
  },
  "required": [
    "id",
    "name",
    "status"
  ],
  "additionalProperties": false,
  "title": "domainbook feature frontmatter"
}
