{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "repaid"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "quadrant": {
      "type": "string",
      "enum": [
        "deliberate-prudent",
        "deliberate-reckless",
        "inadvertent-prudent",
        "inadvertent-reckless"
      ]
    },
    "owners": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{Nd}][\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{Nd}]*)*\\/)?ADR-\\d{4}$",
        "description": "\"ADR-NNNN\", or \"<domain-id>/ADR-NNNN\" for a domain's own log. The pattern uses Unicode property escapes and must be compiled with the ECMA-262 \"u\" flag."
      }
    }
  },
  "required": [
    "status",
    "date",
    "severity",
    "quadrant"
  ],
  "additionalProperties": false,
  "title": "domainbook debt frontmatter"
}
