{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "terms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "default": "draft",
            "type": "string",
            "enum": [
              "draft",
              "validated",
              "deprecated"
            ]
          }
        },
        "required": [
          "name",
          "definition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "terms"
  ],
  "additionalProperties": false,
  "title": "domainbook glossary"
}
