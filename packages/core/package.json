{
  "name": "@domainbook/core",
  "version": "1.0.0",
  "description": "Schemas and shared model for domainbook books",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelAugustScherer/domainbook.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.1"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "schemas": "tsc --build && node scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "vitest": "4.1.10"
  }
}
