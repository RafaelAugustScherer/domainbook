{
  "name": "domainbook",
  "version": "1.0.0",
  "description": "Scaffold and validate a domainbook book",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafaelAugustScherer/domainbook.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24.18.1"
  },
  "bin": {
    "domainbook": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@domainbook/core": "1.0.0",
    "@domainbook/mcp": "1.0.0"
  },
  "peerDependencies": {
    "@domainbook/site": "*"
  },
  "peerDependenciesMeta": {
    "@domainbook/site": {
      "optional": true
    }
  },
  "devDependencies": {
    "@domainbook/site": "*",
    "@types/node": "^24.9.2",
    "vitest": "4.1.10"
  }
}
