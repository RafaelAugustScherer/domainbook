---
import { getEntry } from "astro:content";
import DecisionBody from "../../../../components/DecisionBody.astro";
import Page from "../../../../layouts/Page.astro";
import { collected, pad } from "../../../../lib.ts";

export async function getStaticPaths() {
  const all = await collected("decisions");
  return all
    .map((entry) => entry.data as Record<string, any>)
    .filter((one) => one.domain !== undefined)
    .map((one) => ({ params: { domain: one.domain, number: pad(one.number) } }));
}

const { domain, number } = Astro.params;
const entry = await getEntry("decisions", `${domain}/${number}`);
---

<Page title={(entry!.data as Record<string, any>).title}>
  <DecisionBody entry={entry} />
</Page>
